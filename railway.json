{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "dockerfile": "Dockerfile",
    "dockerfilePath": "."
  },
  "deploy": {
    "startCommand": "python /app/run_http.py",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10,
    "numReplicas": 1,
    "sleepApplicationWhenNotInUse": false
  }
}
